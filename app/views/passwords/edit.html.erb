<main class="auth">
  <div class="auth__container">
    <%= image_tag "Kwenzio_logo_files/Wordmark/kwenzio-wordmark-color-for-light-bg-600px.png", alt: "Kwenzio", class: "auth__logo" %>

    <h1 class="auth__title">Update your password</h1>

    <%= tag.div(flash[:alert], class: "auth__alert") if flash[:alert] %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "auth__form" do |form| %>
      <%= form.password_field :password, class: "auth__input", required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72 %>
      <%= form.password_field :password_confirmation, class: "auth__input", required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72 %>
      <%= form.submit "Save", class: "auth__button" %>
    <% end %>
  </div>
</main>
